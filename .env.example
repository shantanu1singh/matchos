# Copy this file to .env.local and fill in your credentials.
# Azure Foundry defaults. Copy the RESOURCE endpoint and key from Get code.
# Use the HTTPS root, e.g. https://your-resource.services.ai.azure.com
# (not a project URL, /openai/v1, or the full /systemone URL).
DECISION_PROVIDER=azure
REASONING_PROVIDER=azure
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
AZURE_AUTH_MODE=key
AZURE_DECISION_DEPLOYMENT=Decision-1
AZURE_REASONING_DEPLOYMENT=gpt-6-luna
DECISION_TIMEOUT_S=10
REASONING_TIMEOUT_S=15

# Optional: separate resource endpoints/keys for the two deployments.
# AZURE_DECISION_ENDPOINT=
# AZURE_DECISION_API_KEY=
# AZURE_REASONING_ENDPOINT=
# AZURE_REASONING_API_KEY=
# AZURE_OPENAI_API_VERSION=preview

# Optional keyless auth: AZURE_AUTH_MODE=entra, then run az login locally.
# DefaultAzureCredential also supports managed identity and service principals
# (AZURE_TENANT_ID, AZURE_CLIENT_ID, AZURE_CLIENT_SECRET).

# Switch decision providers with DECISION_PROVIDER=cloudflare or vercel.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/cloudflare/clef-flash

# Keep these settings to switch back with DECISION_PROVIDER=vercel.
AI_GATEWAY_API_KEY=
DECISION_MODEL=convaiinnovations/laya-free

# Switch back to Vertex with REASONING_PROVIDER=litellm.
VERTEXAI_PROJECT=
VERTEXAI_LOCATION=global
REASONING_MODEL=vertex_ai/gemini-3.8-flash

# Vertex uses Application Default Credentials. For local development:
# gcloud auth application-default login
# Or set a credential file path:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/credentials.json

# Optional replacement LiteLLM reasoning provider (REASONING_PROVIDER=litellm):
# REASONING_API_KEY=
# REASONING_BASE_URL=

# Optional Foundry tracing and evaluation SDKs.
# Install once: .venv/bin/python -m pip install -r requirements-observability.txt
# MATCHOS_OTEL_ENABLED=1
# Compact cloud traces by default; use full for framework internals/raw stage payloads.
# MATCHOS_TRACE_MODE=compact
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=https://...
# Export sanitized inputs/outputs too (off by default). SDK sensitive logging stays off.
# MATCHOS_TRACE_CONTENT=1
# Link the SAME Application Insights resource to your Foundry project to see traces there.
# Alternative/additional collector export:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Foundry cloud grading uses Entra auth (az login locally), independently of inference API keys.
# This is the PROJECT URL, unlike AZURE_FOUNDRY_ENDPOINT above.
# AZURE_AI_PROJECT_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT
# MATCHOS_EVAL_JUDGE_DEPLOYMENT=YOUR-SUPPORTED-JUDGE-DEPLOYMENT

# Optional spoken commentary. Uses an Azure Speech-capable resource key and region.
# MATCHOS_SPEECH_ENABLED=1
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=eastus
# AZURE_SPEECH_MODEL=MAI-Voice-2.1-Flash
# SPEECH_TIMEOUT_S=12
# Optional full voice IDs; choose voices that support the mapped SSML styles.
# AZURE_SPEECH_VOICE_BROADCASTER_EN=en-GB-Emily:MAI-Voice-2.1-Flash
# AZURE_SPEECH_VOICE_ANALYST_EN=en-US-Grant:MAI-Voice-2.1-Flash
# AZURE_SPEECH_VOICE_FAN_EN=en-GB-Emily:MAI-Voice-2.1-Flash
# AZURE_SPEECH_VOICE_BROADCASTER_HI=hi-IN-Dhruv:MAI-Voice-2.1-Flash
# AZURE_SPEECH_VOICE_ANALYST_HI=hi-IN-Harper:MAI-Voice-2.1-Flash
# AZURE_SPEECH_VOICE_FAN_HI=hi-IN-Priya:MAI-Voice-2.1-Flash
