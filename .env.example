# Copy this file to .env.local and fill in your credentials.
# Azure Foundry defaults. Copy the RESOURCE endpoint and key from Get code.
# Use the HTTPS root, e.g. https://your-resource.services.ai.azure.com
# (not a project URL, /openai/v1, or the full /systemone URL).
DECISION_PROVIDER=azure
REASONING_PROVIDER=azure
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
AZURE_AUTH_MODE=key
AZURE_DECISION_DEPLOYMENT=Decision-1
AZURE_REASONING_DEPLOYMENT=gpt-6-luna
DECISION_TIMEOUT_S=10
REASONING_TIMEOUT_S=15

# Optional: separate resource endpoints/keys for the two deployments.
# AZURE_DECISION_ENDPOINT=
# AZURE_DECISION_API_KEY=
# AZURE_REASONING_ENDPOINT=
# AZURE_REASONING_API_KEY=
# AZURE_OPENAI_API_VERSION=preview

# Optional keyless auth: AZURE_AUTH_MODE=entra, then run az login locally.
# DefaultAzureCredential also supports managed identity and service principals
# (AZURE_TENANT_ID, AZURE_CLIENT_ID, AZURE_CLIENT_SECRET).

# Switch decision providers with DECISION_PROVIDER=cloudflare or vercel.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/cloudflare/clef-flash

# Keep these settings to switch back with DECISION_PROVIDER=vercel.
AI_GATEWAY_API_KEY=
DECISION_MODEL=convaiinnovations/laya-free

# Switch back to Vertex with REASONING_PROVIDER=litellm.
VERTEXAI_PROJECT=
VERTEXAI_LOCATION=global
REASONING_MODEL=vertex_ai/gemini-3.8-flash

# Vertex uses Application Default Credentials. For local development:
# gcloud auth application-default login
# Or set a credential file path:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/credentials.json

# Optional replacement LiteLLM reasoning provider (REASONING_PROVIDER=litellm):
# REASONING_API_KEY=
# REASONING_BASE_URL=

# Optional Agent Framework/OpenTelemetry export to your collector.
# Install once: .venv/bin/python -m pip install -e '.[telemetry]'
# MATCHOS_OTEL_ENABLED=1
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
